# The service consumes an existing camera stream. It never launches mipi_cam.
MUSE_PET_LEFT_TOPIC=/image_left_raw
MUSE_PET_RIGHT_TOPIC=/image_right_raw
MUSE_PET_GESTURE_TOPIC=/muse/gestures
MUSE_PET_OBJECT_TOPIC=/muse/objects
MUSE_PET_EXTRA_DETECTOR_TOPICS=
MUSE_PET_SOCKET_PATH=/run/muse-ui/input.sock

# Set these to true only after installing the matching TROS packages and models.
MUSE_PET_START_GESTURE=false
MUSE_PET_START_YOLO=false
MUSE_PET_AUTO_DISCOVER=false
MUSE_PET_THROTTLE=true
MUSE_PET_INFERENCE_FPS=10.0
MUSE_PET_BODY_IMAGE_GAP=0

# Optional model overrides:
# Model Zoo X5 models use Bayes-e .bin. Keep vendor TROS model filenames.
# MUSE_PET_MONO2D_MODEL_FILE=/absolute/path/to/model.bin
# MUSE_PET_HAND_LMK_MODEL_FILE=/absolute/path/to/model.bin
# MUSE_PET_GESTURE_MODEL_FILE=/absolute/path/to/model.bin
# MUSE_PET_GESTURE_MODEL_NAME=graph_name_inside_custom_model
# MUSE_PET_YOLO_CONFIG_FILE=/absolute/path/to/yolov8workconfig.json
