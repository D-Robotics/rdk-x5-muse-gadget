# Common image transport profile. Activate with scripts/select-pet-transport.py.
MUSE_PET_TRANSPORT=shm
# GS130WI: quarter-size VSE output keeps the 1088x1280 aspect ratio. TROS 2.4.1
# handLMKs rejects expanded hand ROIs >=255px; full-size near hands exceed it.
MUSE_PET_SHM_SUBSTREAM=true
MUSE_PET_SUB_IMAGE_WIDTH=272
MUSE_PET_SUB_IMAGE_HEIGHT=320
# Optional shared source overrides (ordinary MUSE_PET_LEFT_TOPIC stays UDP-only):
# MUSE_PET_SHM_LEFT_TOPIC=/hbmem_left_img
# MUSE_PET_SHM_RIGHT_TOPIC=/hbmem_right_img
