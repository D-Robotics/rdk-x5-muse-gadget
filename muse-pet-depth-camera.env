# Shared GS130WI profile: calibrated stereo main + raw gesture/preview substream.
# Requires hobot_mipi_cam >= 2.5.2 and the project's SHM transport profile.
MUSE_PET_CAMERA_WIDTH=640
MUSE_PET_CAMERA_HEIGHT=352
MUSE_PET_CAMERA_FPS=30.0
MUSE_PET_CAMERA_COMBINE=1
MUSE_PET_CAMERA_STREAM_MODE=1
MUSE_PET_CAMERA_CALIBRATION=default
MUSE_PET_CAMERA_SYNC=true
MUSE_PET_CAMERA_CHANNEL=0
MUSE_PET_CAMERA_CHANNEL2=2
